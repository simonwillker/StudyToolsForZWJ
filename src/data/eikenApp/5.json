  "grammar": [
    {
      "id": "g5-01",
      "sentence": "This ___ my mother.",
      "ja": "これは私の母です。",
      "point": "be動詞（is）の使い方：This / That の後は is",
      "choices": [
        { "text": "is", "correct": true, "explain": "主語が This（単数）なので be動詞は is を使います。" },
        { "text": "am", "correct": false, "explain": "am は主語が I のときだけ使います。" },
        { "text": "are", "correct": false, "explain": "are は主語が you や複数のときに使います。" },
        { "text": "be", "correct": false, "explain": "be はそのままの形では文の中で使えません。" }
      ]
    },
    {
      "id": "g5-02",
      "sentence": "I ___ soccer every Sunday.",
      "ja": "私は毎週日曜日にサッカーをします。",
      "point": "一般動詞の現在形：主語が I のときは動詞に s をつけない",
      "choices": [
        { "text": "play", "correct": true, "explain": "主語が I のとき、一般動詞はそのままの形（原形）を使います。" },
        { "text": "plays", "correct": false, "explain": "plays は主語が he / she / it のときに使う形です。" },
        { "text": "playing", "correct": false, "explain": "playing は be動詞と一緒に使う進行形の形です。" },
        { "text": "played", "correct": false, "explain": "played は過去形なので、every Sunday（現在の習慣）には合いません。" }
      ]
    },
    {
      "id": "g5-03",
      "sentence": "___ you like cats?",
